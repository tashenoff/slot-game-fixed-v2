# API сервер
# Для локальной разработки:
# VITE_API_URL=https://mediaway.duckdns.org/api
# VITE_API_URL=http://localhost:5000/api

# Для работы из любой сети (туннель/локальная сеть) — относительный путь,
# запросы идут на тот же хост, где открыт фронт, и проксируются в vite.config.ts на 5000
VITE_API_URL=/api