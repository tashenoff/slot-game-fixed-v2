# Пример конфигурации
# Скопируй в .env и настрой под себя

# URL бекенда
# Локально:
VITE_API_URL=http://localhost:5000/api

# На сервере:
# VITE_API_URL=http://89.218.15.72:5000/api

# HTTPS (если настроен):
# VITE_API_URL=https://your-domain.com/api

# Telegram Mini App:
# SDK (window.Telegram.WebApp) определяется автоматически при запуске внутри Telegram.
# Бот-токен хранится только на сервере в backend/.env (TELEGRAM_BOT_TOKEN).
# Для принудительного включения Telegram-режима вне Telegram (локальная отладка):
# http://localhost:3002?platform=telegram
