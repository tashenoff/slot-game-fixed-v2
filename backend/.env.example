# Telegram Bot Token для Telegram Mini App
# Получить у @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL фронтенда (игры) — обязательно HTTPS для Telegram Mini App
# https://your-domain.com — замени на свой домен или ngrok-ссылку
TELEGRAM_APP_URL=https://your-frontend-url.com